PORT=3000
# للاختبار المحلي كـ PWA: PORT=8080 ثم npm run dev
ADMIN_PASSWORD=123456
ADMIN_SECRET=

# ═══════════════════════════════════════════════════════════
# PWA Push Notifications (VAPID)
# توليد المفاتيح: npm run pwa:vapid
# ═══════════════════════════════════════════════════════════
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@alheef.website

# ═══════════════════════════════════════════════════════════
# Supabase — مشروع الهيف (مطلوب لحفظ الإعلانات)
# Dashboard: https://supabase.com/dashboard/project/imostnqoxeqefshtzcxd
# Settings → API → انسخ Project URL و service_role
# على Railway: Service → Variables → أضف نفس القيم ثم Redeploy
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=https://imostnqoxeqefshtzcxd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → anon public (اختياري)
SUPABASE_ANON_KEY=

# Project Settings → Database → Database password (مطلوب لتشغيل npm run migrate:sql)
SUPABASE_DB_PASSWORD=

# Fallback contact (عند فشل Supabase فقط)
WHATSAPP_NUMBER=966500000000
INSTAGRAM_URL=https://instagram.com/alheef
X_URL=https://x.com/alheef
PHONE_DISPLAY=050 000 0000
