PORT=3000
# للاختبار المحلي كـ PWA: PORT=8080 ثم npm run dev

# ─── دخول لوحة الإدارة (إلزامي) ───
# لا تضع قيماً افتراضية ضعيفة. أنشئ سراً عشوائياً طويلاً لـ ADMIN_SECRET.
ADMIN_PASSWORD=
# اختياري: بدل النص الصريح — scrypt من: node scripts/generate-admin-password-hash.js
ADMIN_PASSWORD_HASH=
ADMIN_PHONE=
ADMIN_SECRET=

# سر استيراد الخريطة لـ ChatGPT. يُرسل كـ Authorization: Bearer. لا تضعه في الواجهة أو Git.
ALHEEF_MAP_IMPORT_SECRET=

# بوابة موافقة واتساب لطلبات الخريطة. القيم السرية تبقى في البيئة فقط.
# الطلب يبقى بانتظار الموافقة حتى يوافق الأدمن أو يرفضه أو يلغيه. لا توجد مدة انتهاء.
ALHEEF_MAP_INTEGRATION_KEY=
# مفتاح نموذج /map-submit. رابط خاص فقط، لا يُعرض في الموقع ولا في Git.
MAP_SUBMIT_TOKEN=
# رمز موصل ChatGPT للعملاء الذين يرسلون Authorization مباشرة. ليس مفتاح التكامل، ولا يُوضع في المحادثة أو الواجهة أو الرابط.
# موصل ChatGPT نفسه يستخدم OAuth على /oauth/authorize ولا يقبل هذا الرمز في شاشته.
ALHEEF_CHATGPT_CONNECTOR_TOKEN=
ALHEEF_MAP_ADMIN_PHONE=966530792754
ALHEEF_PUBLIC_BASE_URL=
ALHEEF_WHATSAPP_WEBHOOK_SECRET=


# ═══════════════════════════════════════════════════════════
# Railway / الإنتاج — أضف نفس القيم في Railway → Variables
# في الإنتاج يتوقف التشغيل إن نقص ADMIN_PASSWORD/HASH أو ADMIN_PHONE
# أو إن كان سر التوقيع مفقوداً / غير آمن
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
# PORT يُعيَّن تلقائياً من Railway — لا تثبّته يدوياً في الإنتاج

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@alheef.com

# البريد — استعادة كلمة مرور المسوقين (اختياري حتى التفعيل)
SITE_URL=https://www.alheef.website
EMAIL_FROM=noreply@alheef.website
RESEND_API_KEY=

# ═══════════════════════════════════════════════════════════
# Supabase — Project Settings → API
# على Railway: Service → Variables → أضف نفس القيم ثم Redeploy
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → anon public (اختياري للقراءة العامة عبر anon فقط)
SUPABASE_ANON_KEY=

# Project Settings → Database → Database password
# مطلوب لتفعيل «كن أحد فريق الهيف» تلقائياً عند تشغيل السيرفر
SUPABASE_DB_PASSWORD=

# Fallback contact (عند فشل Supabase فقط)
WHATSAPP_NUMBER=
INSTAGRAM_URL=
X_URL=
PHONE_DISPLAY=

# واتساب OTP عبر Evolution API — السيرفر فقط. لا تضع المفتاح في HTML/JS ولا في Git.
EVOLUTION_API_DOMAIN=
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=otp
EVOLUTION_API_KEY=
