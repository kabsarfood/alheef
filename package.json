{
  "name": "alheef-real-estate",
  "version": "1.0.0",
  "description": "الهيف للخدمات العقارية — مكتب عقاري اكتروني تعريفي",
  "main": "server.js",
  "scripts": {
    "start": "node --use-system-ca server.js",
    "dev": "node --use-system-ca server.js",
    "dev:8080": "node --use-system-ca -e \"process.env.PORT='8080'; require('./server.js')\"",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "pwa:vapid": "node scripts/setup-vapid-env.js",
    "pwa:railway": "node scripts/sync-vapid-railway.js",
    "pwa:test": "node --use-system-ca scripts/test-pwa-flow.js",
    "build": "node -e \"require('fs').accessSync('server.js'); console.log('build ok')\"",
    "postinstall": "node -e \"console.log('deps ok')\"",
    "migrate:supabase": "node --use-system-ca scripts/migrate-json-to-supabase.js",
    "migrate:sql": "node --use-system-ca scripts/apply-migrations.js",
    "check:supabase": "node --use-system-ca scripts/check-supabase.js"
  },
  "engines": {
    "node": "18.x",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "real-estate",
    "alheef",
    "عقارات"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "2.49.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "multer": "1.4.5-lts.2",
    "web-push": "^3.6.7"
  }
}
